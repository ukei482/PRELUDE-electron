#!/bin/bash
# PRELUDE の新しいタブ(Omarchy)。docs/omarchy.md の「新しいタブ」
# 空いている番号の作業領域へ移り、Omarchy のアプリの一覧(omarchy.dock apps)を開く。
# 選んだアプリの窓はその作業領域に出て、コアが引き取って新しいタブにする(windows.adopt = "tabs")。
# 空いている番号 = PRELUDE のタブの番号でも、窓のある作業領域の番号でもない、いちばん小さい数
set -uo pipefail

# 使っている番号(PRELUDE のタブ・窓のある作業領域)の次の空き。JSON は python で読む(Arch の既定にある)
n=$(
  python3 -I -c '
import json, sys
used = set()
for i, text in enumerate(sys.argv[1:]):
    try:
        v = json.loads(text)
    except ValueError:
        continue
    if i == 0:
        used |= {t.get("num") for t in v.get("tabs", [])}
    else:
        used |= {w.get("id") for w in v if w.get("windows", 0) > 0}
n = 1
while n in used:
    n += 1
print(n)
' "$(prelude raw state.get 2>/dev/null)" "$(hyprctl workspaces -j 2>/dev/null)"
)
[[ $n =~ ^[0-9]+$ ]] || n=1

# Hyprland 0.5x(Lua)の形を先に、通らなければ前の形で
if ! hyprctl dispatch "hl.dsp.focus({ workspace = \"$n\" })" 2>/dev/null | grep -qx ok; then
  hyprctl dispatch workspace "$n" >/dev/null 2>&1
fi
exec omarchy-shell omarchy.dock apps
