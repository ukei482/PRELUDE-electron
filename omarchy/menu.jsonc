{
  // PRELUDE の項目(scripts/omarchy.sh が ~/.config/omarchy/extensions/omarchy-menu.jsonc に足す)。
  // バーの PRELUDE を右クリック、または `omarchy menu summon prelude` で開く
  "prelude": {"icon":"󰕮","label":"PRELUDE","description":"スペース・ブックマーク・タブ"},
  "prelude.open": {"icon":"󰍉","label":"開く","description":"タブ・ブックマーク・アプリ・スペースを選んで開く","action":"prelude-omarchy-launcher"},
  "prelude.agent": {"icon":"󰚩","label":"AI","description":"今のブックマークのフォルダで既定の AI を開く","action":"prelude new agent"},
  "prelude.files": {"icon":"󰉋","label":"ファイラ","description":"今のブックマークのフォルダを開く","action":"prelude new files"},
  "prelude.save": {"icon":"󰃀","label":"ブックマークに今の並びを保存","description":"今のタブの並びを、そのタブのブックマークに上書きする","action":"prelude bookmark overwrite"},
  "prelude.settings": {"icon":"󰒓","label":"設定を編集","action":"omarchy-launch-editor ~/.config/prelude/settings.toml"},
  "prelude.restart": {"icon":"󰜉","label":"コアを起動し直す","action":"pkill -x prelude-core; uwsm-app -- prelude-core"},
}
