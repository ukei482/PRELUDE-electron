[Unit]
Description=PRELUDE desktop shell
Documentation=file://@APPDIR@/docs/shell-design.md
After=plasma-kwin_wayland.service
PartOf=graphical-session.target
# 短時間に落ち続けたら failed になり、下の OnFailure で plasmashell に戻す
StartLimitIntervalSec=60
StartLimitBurst=3
OnFailure=prelude-shell-fallback.service

[Service]
ExecStart=@APPDIR@/node_modules/electron/dist/electron @APPDIR@ --no-sandbox
# 停止時の SIGTERM はメインプロセスだけに送る(Chromium の子プロセスにも同時に送ると、メインがクラッシュして異常終了扱いになる)
KillMode=mixed
# 終了処理(取り込みアプリを穏やかに閉じる)の待ち時間を含めて、この時間で必ず終わらせる。90秒待たされると切り替えが固まって見える
TimeoutStopSec=20
Restart=on-failure
RestartSec=1

[Install]
WantedBy=plasma-workspace.target
